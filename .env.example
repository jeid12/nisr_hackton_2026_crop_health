# Copy this file to .env and change the values. Never commit .env.

# Backend sign-in (dashboard login). Defaults: admin / crophealth2026
CROPHEALTH_USER=admin
CROPHEALTH_PASSWORD=change-me
# Token signing key. If unset, a random key is created at startup and sessions reset on restart.
CROPHEALTH_SECRET=change-me-to-a-long-random-string

# Dashboard: address of the backend API the browser calls (set to your deployed API URL on Render)
API_BASE=http://localhost:8000
